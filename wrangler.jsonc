// Cloudflare Workers config — static/ served as assets, /api/* handled by worker/index.js.
// Deploy: npx wrangler deploy   (set the key once with: npx wrangler secret put CTA_API_KEY)
{
  "name": "cta-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./static" },
  "workers_dev": true,
  "routes": [{ "pattern": "trains.bakerterminal.com", "custom_domain": true }],
  // bus_stops.json (1 MB) is served verbatim, so bundle it as text instead of parsing it at startup
  "rules": [{ "type": "Text", "globs": ["**/bus_stops.json"], "fallthrough": false }],
  // hard per-request CPU ceiling (requests use a few ms); guards against runaway CPU billing
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": true }
}
